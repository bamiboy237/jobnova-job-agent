{
  "name": "job-agent",
  "version": "0.1.0",
  "description": "Server-side job agent resolving LinkedIn listings and submitting ATS applications",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc",
    "build:web": "next build web",
    "test": "vitest run",
    "serve": "node dist/server.js",
    "resolve": "tsx src/index.ts",
    "auth": "tsx src/auth.ts",
    "profile:synthetic": "tsx src/apply/generateSyntheticProfile.ts",
    "apply:chat": "tsx src/apply/chatCli.ts",
    "apply:test": "tsx src/apply/cli.ts",
    "apply:test:factual": "tsx src/apply/cli.ts --factual",
    "apply:submit": "tsx src/apply/cli.ts --submit"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.93",
    "@browserbasehq/sdk": "^2.2.0",
    "@libsql/client": "^0.17.4",
    "@mastra/agent-browser": "^0.5.1",
    "@mastra/core": "^1.63.2",
    "@mastra/libsql": "^1.22.2",
    "@mastra/memory": "^1.28.1",
    "@mastra/stagehand": "^0.3.3",
    "ai": "^7.0.90",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "pdfkit": "^0.20.2",
    "playwright-core": "^1.50.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
