# Gemini AI API Key (used for Gemini 3.7 Flash)
GEMINI_API_KEY=

# Runtime model provider: openai or gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Browser runtime: browserbase (production default) or local (development)
BROWSER_PROVIDER=browserbase

# Browserbase Credentials (used for remote Chromium session)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional: Browserbase persistent Context ID (if using authenticated session)
BROWSERBASE_CONTEXT_ID=
