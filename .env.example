# Runtime model provider: gemini, openai, or deepseek. Gemini 3.7 Flash is the default.
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Browser runtime: browserbase (production default) or local (development)
BROWSER_PROVIDER=browserbase

# Persistent Mastra memory. Use file:/data/mastra.db on a deployed persistent volume.
MASTRA_DATABASE_URL=file:./mastra.db
MASTRA_DATABASE_AUTH_TOKEN=

# Browserbase Credentials (used for remote Chromium session)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional: Browserbase persistent Context ID (if using authenticated session)
BROWSERBASE_CONTEXT_ID=
